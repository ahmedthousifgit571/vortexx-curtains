# Public site URL (used for metadata / OG / sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Quote form email via Resend (https://resend.com). Without a key, dev logs the request to the console.
RESEND_API_KEY=
# Must be a sender on a domain you've verified in Resend. The default onboarding@resend.dev
# only delivers to the Resend account owner's own address.
QUOTE_FROM_EMAIL="Lourtex Website <onboarding@resend.dev>"
QUOTE_TO_EMAIL=curttex2026@gmail.com

# The home page reviews are samples until real ones arrive (lib/testimonials.ts). Samples are
# hidden in production builds; set this to "true" only on a preview deploy to see the section.
SHOW_SAMPLE_REVIEWS=
