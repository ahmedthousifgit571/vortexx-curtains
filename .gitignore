# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
desktop.ini
*.pem

# editor / local tool settings
.vscode/*
!.vscode/extensions.json
.idea/
.claude/settings.local.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Raw media downloads (sources for public/media encodes; never deployed)
/.media-original/
# Unused 5 MB raw clip (nothing references it); the site uses public/media/ encodes
/public/vidoes/
